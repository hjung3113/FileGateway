<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 테스트 host의 cwd는 bin 출력 디렉터리이므로 db 계약 스크립트를 출력으로 복사해 BaseDirectory에서 읽는다. -->
    <Content Include="..\..\db\*.sql" CopyToOutputDirectory="PreserveNewest" Link="db\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FubarDev.FtpServer" Version="3.1.2" />
    <PackageReference Include="FubarDev.FtpServer.FileSystem.InMemory" Version="3.1.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileGateway.Api\FileGateway.Api.csproj" />
    <ProjectReference Include="..\..\src\FileGateway.Logs\FileGateway.Logs.csproj" />
    <ProjectReference Include="..\..\src\FileGateway.Configurations\FileGateway.Configurations.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <ProjectReference Include="..\FileGateway.UnitTests\FileGateway.UnitTests.csproj" />
  </ItemGroup>

</Project>